load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@rules_python//python:py_library.bzl", "py_library")
load("@rules_python//python:py_test.bzl", "py_test")
load("@sonic_wheel_pip//:requirements.bzl", "requirement")
load("//python:site_packages.bzl", "site_packages")
load("//python:source_package.bzl", "python_runtime_packages")
load("//python:runtime_lock.bzl", "python_runtime_plan")
load("//python:wheel_layer.bzl", "wheel_layer")
load(":inherited_runtime_fixture.bzl", "inherited_runtime_fixture")
load(":site_packages_contract.bzl", "demo_targets")

package(default_testonly = True)

demo_targets(name = "demo")

wheel_layer(
    name = "wheel_demo_runtime",
    wheels = [":demo_wheel"],
    site_packages = "/opt/runtime/site",
    scripts = "/opt/runtime/bin",
    headers = "/opt/runtime/include",
    data_prefix = "/opt/runtime",
    interpreter = "/usr/bin/python3",
    runtime_deps = [":leaf"],
)

filegroup(
    name = "wheel_demo_metadata",
    srcs = [":wheel_demo_runtime"],
    output_group = "metadata",
)

python_runtime_plan(
    name = "wheel_demo_plan",
    packages = [":wheel_demo_runtime"],
    roots = ["site-demo[metrics]"],
    source_distributions = ["site-demo", "leaf-package"],
    site_packages = ["/opt/runtime/site"],
    python_version = "3.13",
    python_platform = "x86_64-unknown-linux-gnu",
    uv_version = "0.12.18",
)

py_test(
    name = "wheel_runtime_test",
    srcs = ["wheel_runtime_test.py"],
    args = [
        "--wheel=$(location :demo_wheel)",
        "--tar=$(location :wheel_demo_runtime)",
        "--plan=$(location :wheel_demo_plan)",
        "--metadata",
        "$(locations :wheel_demo_metadata)",
    ],
    data = [":demo_wheel", ":wheel_demo_runtime", ":wheel_demo_plan", ":wheel_demo_metadata"],
    python_version = "3.11",
)

write_file(
    name = "generated_data",
    out = "site_demo/generated.txt",
    content = [
        "generated package data",
        "",
    ],
)

py_library(
    name = "demo_library",
    srcs = [
        "site_demo/__init__.py",
        "site_demo/cli.py",
    ],
    data = [
        "site_demo/default.json",
        ":generated_data",
    ],
    imports = ["."],
)

site_packages(
    name = "leaf",
    data_prefix = "/opt/runtime",
    distribution = "leaf-package",
    headers = "/opt/runtime/include",
    interpreter = "/usr/bin/python3",
    scripts = "/opt/runtime/bin",
    site_packages = "/opt/runtime/site",
    version = "1.3",
)

site_packages(
    name = "root",
    data_prefix = "/opt/runtime",
    distribution = "root-package",
    headers = "/opt/runtime/include",
    interpreter = "/usr/bin/python3",
    requires = [
        "site-demo[metrics]>=2.4",
        "leaf-package>=1.0",
    ],
    scripts = "/opt/runtime/bin",
    site_packages = "/opt/runtime/site",
    version = "4.0",
    runtime_deps = [
        ":demo",
        ":leaf",
    ],
)

python_runtime_packages(
    name = "image_packages",
    deps = [":root"],
)

filegroup(
    name = "image_metadata",
    srcs = [":image_packages"],
    output_group = "metadata",
)

write_file(
    name = "raw_source_script",
    out = "source-script.py",
    content = [
        "#!/usr/bin/env python3",
        "print('script payload')",
        "",
    ],
)

write_file(
    name = "plain_source_script",
    out = "plain-script.py",
    content = [
        "import ipaddress",
        "",
    ],
)

site_packages(
    name = "normalized_script",
    data_prefix = "/fixture",
    distribution = "script-fixture",
    executable_files = [
        "script_fixture-1.0.data/scripts/helper",
        "script_fixture-1.0.data/scripts/plain.py",
    ],
    files = {
        ":raw_source_script": "script_fixture-1.0.data/scripts/helper",
        ":plain_source_script": "script_fixture-1.0.data/scripts/plain.py",
    },
    headers = "/fixture/include",
    interpreter = "/selected/python3.13",
    normalize_scripts = True,
    regular_file_mode = "0644",
    scripts = "/fixture/bin",
    site_packages = "/fixture/site",
    version = "1.0",
)

site_packages(
    name = "preserved_script",
    data_prefix = "/fixture",
    distribution = "script-fixture",
    executable_files = [
        "script_fixture-1.0.data/scripts/helper",
        "script_fixture-1.0.data/scripts/plain.py",
    ],
    files = {
        ":raw_source_script": "script_fixture-1.0.data/scripts/helper",
        ":plain_source_script": "script_fixture-1.0.data/scripts/plain.py",
    },
    headers = "/fixture/include",
    interpreter = "/unselected/python3",
    regular_file_mode = "0644",
    scripts = "/fixture/bin",
    site_packages = "/fixture/site",
    version = "1.0",
)

py_test(
    name = "site_packages_test",
    srcs = ["site_packages_test.py"],
    args = [
        "--normalized-script=$(rootpath :normalized_script)",
        "--preserved-script=$(rootpath :preserved_script)",
        "--raw-script=$(rootpath :raw_source_script)",
        "--plain-script=$(rootpath :plain_source_script)",
        "--demo",
        "$(location :demo)",
        "--wheel",
        "$(location :demo_wheel)",
        "--tars",
        "$(locations :image_packages)",
        "--metadata",
        "$(locations :image_metadata)",
    ],
    data = [
        ":demo",
        ":demo_wheel",
        ":image_metadata",
        ":image_packages",
        ":normalized_script",
        ":plain_source_script",
        ":preserved_script",
        ":raw_source_script",
    ],
    python_version = "3.11",
)

py_test(
    name = "source_package_builder_test",
    srcs = ["source_package_builder_test.py"],
    python_version = "3.11",
    deps = [
        "//python:source_package_lib",
        requirement("installer"),
    ],
)

# Preserve the existing source-only API while distributions adopt explicit metadata.
site_packages(
    name = "legacy",
    srcs = [":demo_library"],
)

py_test(
    name = "runtime_lock_test",
    srcs = ["runtime_lock_test.py"],
    python_version = "3.11",
    deps = ["//python:runtime_lock_lib"],
)

exports_files(["runtime_lock_update_test.py"])

py_library(
    name = "runtime_lock_test_support",
    srcs = ["runtime_lock_test.py"],
    imports = ["."],
    visibility = ["//visibility:public"],
    deps = ["//python:runtime_lock_lib"],
)

inherited_runtime_fixture()
