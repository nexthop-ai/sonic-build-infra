load("@rules_python//python:defs.bzl", "py_test")
load("@sonic_build_infra//tar:sonic_deploy_tar.bzl", "sonic_deploy_tar")
load("@sonic_build_infra//oci:runtime_packages.bzl", "runtime_packages")
load("@sonic_build_infra//oci:source_controls.bzl", "source_package_controls")

sonic_deploy_tar(
    name = "payload",
    srcs = ["resource.txt", "service.init"],
    mtree = [
        "./usr/share/control-consumer/resource type=file uid=0 gid=0 mode=0644 time=0 content=$(location resource.txt)",
        "./etc/init.d/control-consumer type=file uid=0 gid=0 mode=0755 time=0 content=$(location service.init)",
    ],
)
runtime_packages(
    name = "metadata",
    control = "control",
    changelog = "changelog",
    packages = {"control-consumer": ":payload"},
)
source_package_controls(name = "controls", metadata = ":metadata", package = "control-consumer")
filegroup(name = "receipt", srcs = [":controls"], output_group = "receipt")
runtime_packages(
    name = "metadata_helpers",
    control = "control",
    changelog = "changelog",
    packages = {"control-consumer": ":payload"},
    debian_files = {"control-consumer.init": "service.init"},
    control_file_helpers = [["dh_installinit", "--no-start"], ["dh_installdeb"]],
)
source_package_controls(name = "controls_helpers", metadata = ":metadata_helpers", package = "control-consumer")

py_test(
    name = "consumer_test",
    srcs = ["consumer_test.py"],
    args = ["$(rootpath :controls)", "$(rootpath :receipt)", "$(rootpath :metadata)", "$(rootpath :controls_helpers)", "$(rootpath :metadata_helpers)"],
    data = [":controls", ":receipt", ":metadata", ":controls_helpers", ":metadata_helpers"],
)
